---
// 主题切换按钮：点击在 light/dark 间切换，选择存入 localStorage
---

<button
  id="theme-toggle"
  type="button"
  title="切换主题"
  class="inline-flex cursor-pointer items-center p-1"
  aria-label="切换主题"
>
  <span id="theme-toggle-moon" class="i-mdi-weather-night block w-6 h-6"></span>
  <span id="theme-toggle-sun" class="i-mdi-weather-sunny hidden w-6 h-6"></span>
</button>

<script>
  function syncThemeIcons() {
    const dark = document.documentElement.classList.contains('dark')
    const moon = document.getElementById('theme-toggle-moon')
    const sun = document.getElementById('theme-toggle-sun')
    if (moon && sun) {
      moon.classList.toggle('hidden', dark)
      sun.classList.toggle('hidden', !dark)
    }
  }

  syncThemeIcons()

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.contains('dark')
    document.documentElement.classList.toggle('dark', !dark)
    try {
      localStorage.setItem('theme', dark ? 'light' : 'dark')
    } catch {
      /* localStorage 不可用时静默降级 */
    }
    syncThemeIcons()
  })
</script>
